generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  LECTURER
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique @db.VarChar(254)
  displayName  String        @db.VarChar(80)
  passwordHash String
  role         Role
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  verification LecturerVerification?
  sessions     RefreshSession[]
  quizzes      Quiz[]
  attempts     Attempt[]
  courses      Course[]
  enrollments  Enrollment[]
  questionBanks QuestionBank[]
  adultConfirmedAt DateTime?
  aiGenerations AiGeneration[]
  challengeParticipations ChallengeParticipant[]
}

model LecturerVerification {
  id         String             @id @default(uuid()) @db.Uuid
  userId     String             @unique @db.Uuid
  status     VerificationStatus @default(PENDING)
  reviewedBy String?            @db.VarChar(120)
  reason     String?            @db.VarChar(500)
  reviewedAt DateTime?
  createdAt  DateTime           @default(now())
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshSession {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  familyId   String   @db.Uuid
  tokenHash  String   @unique @db.Char(64)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId, expiresAt])
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actor      String   @db.VarChar(120)
  action     String   @db.VarChar(80)
  resourceId String   @db.Uuid
  reason     String   @db.VarChar(500)
  createdAt  DateTime @default(now())

  @@index([resourceId, createdAt])
}

enum QuizMode {
  ASSESSMENT
  PRACTICE
  CHALLENGE
}

enum QuizStatus {
  DRAFT
  PUBLISHED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

model Quiz {
  id               String     @id @default(uuid()) @db.Uuid
  ownerId          String     @db.Uuid
  mode             QuizMode   @default(PRACTICE)
  status           QuizStatus @default(DRAFT)
  title            String     @db.VarChar(150)
  description      String     @default("") @db.VarChar(2000)
  timeLimitSeconds Int?
  revision         Int        @default(0)
  publishedAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  courseId         String?    @db.Uuid
  opensAt          DateTime?
  closesAt         DateTime?
  closedAt         DateTime?
  maxAttempts      Int        @default(1)
  course           Course?    @relation(fields: [courseId], references: [id], onDelete: Restrict)
  owner            User       @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  questions        QuizQuestion[]
  attempts         Attempt[]
  challenge        Challenge?

  @@index([ownerId, createdAt])
  @@index([courseId, status])
}

model QuizQuestion {
  id          String @id @default(uuid()) @db.Uuid
  quizId      String @db.Uuid
  position    Int
  prompt      String @db.VarChar(2000)
  explanation String @default("") @db.VarChar(2000)
  quiz        Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options     QuizQuestionOption[]
  answers     AttemptAnswer[]

  @@unique([id, quizId])
  @@unique([quizId, position])
}

model QuizQuestionOption {
  id         String  @id @default(uuid()) @db.Uuid
  questionId String  @db.Uuid
  position   Int
  text       String  @db.VarChar(500)
  isCorrect  Boolean
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers    AttemptAnswer[]

  @@unique([id, questionId])
  @@unique([questionId, position])
}

model Attempt {
  id              String        @id @default(uuid()) @db.Uuid
  quizId          String        @db.Uuid
  userId          String        @db.Uuid
  attemptNumber   Int
  status          AttemptStatus @default(IN_PROGRESS)
  startedAt       DateTime      @default(now())
  expiresAt       DateTime?
  finalizedAt     DateTime?
  score           Int?
  totalQuestions  Int
  durationSeconds Int?
  quiz            Quiz          @relation(fields: [quizId], references: [id], onDelete: Restrict)
  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  answers         AttemptAnswer[]

  @@unique([id, quizId])
  @@unique([quizId, userId, attemptNumber])
  @@index([userId, startedAt])
  @@index([status, expiresAt])
}

model AttemptAnswer {
  attemptId       String @db.Uuid
  quizId          String @db.Uuid
  questionId      String @db.Uuid
  selectedOptionId String? @db.Uuid
  revision        Int @default(1)
  savedAt         DateTime @default(now())
  attempt         Attempt @relation(fields: [attemptId, quizId], references: [id, quizId], onDelete: Restrict)
  question        QuizQuestion @relation(fields: [questionId, quizId], references: [id, quizId], onDelete: Restrict)
  selectedOption  QuizQuestionOption? @relation(fields: [selectedOptionId, questionId], references: [id, questionId], onDelete: Restrict)

  @@id([attemptId, questionId])
  @@index([questionId, quizId])
  @@index([selectedOptionId, questionId])
}

enum EnrollmentStatus {
  ACTIVE
  LEFT
  REMOVED
}

model Course {
  id                 String @id @default(uuid()) @db.Uuid
  ownerId            String @db.Uuid
  title              String @db.VarChar(150)
  code               String @db.VarChar(30)
  description        String @default("") @db.VarChar(2000)
  enrollmentCodeHash String? @unique @db.Char(64)
  archivedAt         DateTime?
  revision           Int @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  owner              User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  enrollments        Enrollment[]
  assessments        Quiz[]
  questionBanks      QuestionBank[]

  @@unique([ownerId, code])
  @@index([ownerId, createdAt])
}

model Enrollment {
  courseId String @db.Uuid
  studentId String @db.Uuid
  status EnrollmentStatus @default(ACTIVE)
  joinedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  student User @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@id([courseId, studentId])
  @@index([studentId, status])
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model QuestionBank {
  id String @id @default(uuid()) @db.Uuid
  ownerId String @db.Uuid
  courseId String? @db.Uuid
  title String @db.VarChar(150)
  description String @default("") @db.VarChar(2000)
  revision Int @default(0)
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  course Course? @relation(fields: [courseId], references: [id], onDelete: Restrict)
  questions Question[]
  imports CsvImportReceipt[]

  @@index([ownerId, archivedAt, createdAt])
  @@index([courseId])
}

// Bank questions are independent of the immutable QuizQuestion snapshots.
model Question {
  id String @id @default(uuid()) @db.Uuid
  bankId String @db.Uuid
  prompt String @db.VarChar(2000)
  options String[] @db.VarChar(500)
  correctOption Int
  explanation String @default("") @db.VarChar(2000)
  difficulty Difficulty @default(MEDIUM)
  topic String @default("") @db.VarChar(100)
  revision Int @default(0)
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bank QuestionBank @relation(fields: [bankId], references: [id], onDelete: Restrict)

  @@index([bankId, archivedAt, difficulty, createdAt])
}

// No source files are stored. A receipt makes confirmation retries idempotent.
model CsvImportReceipt {
  id String @id @db.Char(64)
  bankId String @db.Uuid
  importedCount Int
  skippedCount Int
  createdAt DateTime @default(now())
  bank QuestionBank @relation(fields: [bankId], references: [id], onDelete: Restrict)

  @@index([bankId, createdAt])
}

enum AiGenerationStatus {
  QUEUED
  RUNNING
  READY
  FAILED
  EXPIRED
  DELETED
}

// Short-lived payloads; accepted questions live only in the existing question banks.
model AiGeneration {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  idempotencyKey String @db.Uuid
  requestHash String @db.Char(64)
  status AiGenerationStatus @default(QUEUED)
  model String @db.VarChar(120)
  input Json?
  result Json?
  acceptance Json?
  failureCode String? @db.VarChar(60)
  summary Json?
  summaryExpiresAt DateTime?
  diagnostics Json?
  phase String @default("QUEUED") @db.VarChar(30)
  providerAttempts Int @default(0)
  charged Boolean @default(false)
  quotaDay String @db.Char(10)
  deadlineAt DateTime
  resultExpiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  completedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, idempotencyKey])
  @@index([userId, quotaDay, charged])
  @@index([status, createdAt])
  @@index([resultExpiresAt])
}

model AiUsageBucket {
  day String @id @db.Char(10)
  providerCalls Int @default(0)
}

// Singleton dispatch lease also enforces project-wide concurrency and pacing.
model AiDispatch {
  id String @id @db.VarChar(20)
  jobId String? @db.Uuid
  leaseUntil DateTime?
  nextCallAt DateTime?
}


model Challenge {
  quizId String @id @db.Uuid
  closesAt DateTime?
  closedAt DateTime?
  inviteCodeHash String? @unique @db.Char(64)
  inviteCodeSealed String?
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Restrict)
  participants ChallengeParticipant[]
  @@index([closesAt])
}
model ChallengeParticipant {
  quizId String @db.Uuid
  studentId String @db.Uuid
  joinedAt DateTime @default(now())
  challenge Challenge @relation(fields: [quizId], references: [quizId], onDelete: Restrict)
  student User @relation(fields: [studentId], references: [id], onDelete: Restrict)
  @@id([quizId, studentId])
  @@index([studentId, joinedAt])
}
