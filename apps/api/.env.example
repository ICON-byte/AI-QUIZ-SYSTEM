NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://quiz:replace-with-local-password@localhost:5432/ai_quiz?schema=public
# Generate independently: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=10
SESSION_DAYS=7
BCRYPT_ROUNDS=12
# Keep 0 for local development. Set the exact proxy hop count only behind a trusted proxy.
TRUST_PROXY_HOPS=0
