NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://quiz:replace-with-local-password@localhost:5432/ai_quiz?schema=public
# Generate independently: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=10
SESSION_DAYS=7
BCRYPT_ROUNDS=12
# Keep 0 for local development. Set the exact proxy hop count only behind a trusted proxy.
TRUST_PROXY_HOPS=0

# Optional AI integration. Leave either value blank to keep AI unavailable.
# Get a key from Google AI Studio; never put it in VITE_* variables.
GEMINI_API_KEY=
# Set an exact structured-output model ID confirmed for YOUR project's free tier.
# No model is selected automatically; availability/quotas can differ by project.
GEMINI_MODEL=
AI_DAILY_USER_LIMIT=5
# Counts actual provider calls, including retries and failures.
AI_DAILY_PROJECT_CALL_LIMIT=20
AI_CALL_INTERVAL_SECONDS=30
AI_JOB_TIMEOUT_SECONDS=120
AI_MAX_OUTPUT_TOKENS=8192
AI_DOCUMENT_MAX_BYTES=5242880
AI_DOCUMENT_MAX_CHARACTERS=40000
AI_DOCUMENT_MAX_PAGES=100
AI_EXTRACTION_TIMEOUT_SECONDS=10
