{
  "name": "ai-quiz-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=24.0.0 <25", "npm": ">=11" },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @quiz/api\" \"npm run dev -w @quiz/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "node scripts/test-postgres.mjs",
    "db:generate": "npm run db:generate -w @quiz/api",
    "db:migrate": "npm run db:migrate -w @quiz/api",
    "db:deploy": "npm run db:deploy -w @quiz/api",
    "lecturer:verify": "npm run lecturer:verify -w @quiz/api --"
  },
  "overrides": { "minimatch": "^11.0.1" },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
